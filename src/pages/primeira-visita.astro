---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Chamada from '../components/Chamada.astro';
import { site } from '../config/site';
import { faqGeral } from '../data/faq';
import entrada from '../assets/fotos/entrada-dia.jpg';
import salao from '../assets/fotos/foto-1.jpg';

const passos = [
  { t: 'Confirme a data', d: `As giras abertas são de 14 em 14 dias, às 18h. Veja as datas no calendário da página Giras ou pergunte pelo WhatsApp ${site.telefone}.` },
  { t: 'Escolha roupa clara', d: 'Branca ou clara, confortável e discreta. Evite roupas curtas ou decotadas.' },
  { t: 'Chegue com antecedência', d: 'Chegando um pouco antes das 18h, você se acomoda na assistência com calma e se apresenta à casa.' },
  { t: 'Aguarde na assistência', d: 'Durante a gira, o público fica sentado na assistência. Quando chegar sua vez, um médium chama você para o atendimento.' },
  { t: 'Tome seu passe', d: 'Diante da entidade, fale o que estiver no seu coração. Não é preciso saber nada de Umbanda: as entidades acolhem e orientam.' },
  { t: 'Siga as orientações', d: 'Se a entidade recomendar algo, pergunte suas dúvidas aos médiuns da casa. Ninguém cobra nada pelo atendimento.' },
];
---
<Base
  title="Primeira visita a um terreiro de Umbanda | Choupana"
  description="Vai a uma gira de Umbanda pela primeira vez? Veja o que vestir, que horas chegar e como é o atendimento gratuito na Choupana, em Lagoinha, Nova Iguaçu."
  breadcrumbs={[{ name: 'Primeira visita', path: '/primeira-visita/' }]}
  faq={faqGeral}
>
  <PageHero
    crumb="Primeira visita"
    eyebrow="Guia da primeira visita"
    titulo="Sua primeira vez num terreiro de Umbanda"
    lead="Não precisa ser da Umbanda, saber os pontos ou conhecer alguém da casa. Basta chegar com respeito. Aqui está tudo o que você precisa saber antes de vir."
    imagem={entrada}
    alt="Quintal da Choupana com plantas e a porta de vidro do salão"
  />

  <section class="pb-20 md:pb-28">
    <div class="wrap">
      <h2 class="text-4xl md:text-5xl text-anil-escuro max-w-2xl">Passo a passo da gira</h2>
      <ol class="mt-12 grid gap-px bg-linha rounded-3xl overflow-hidden ring-1 ring-linha md:grid-cols-2 lg:grid-cols-3">
        {passos.map((p, i) => (
          <li class="bg-cal p-8 md:p-10">
            <span class="font-display text-5xl text-ocre-texto/80 leading-none" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-5 text-2xl md:text-[1.7rem]">{p.t}</h3>
            <p class="mt-3 text-tinta-suave">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-areia/45 py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-6">
        <Image src={salao} alt="Assistência da Choupana com cadeiras brancas voltadas para o congá" widths={[640, 1024, 1400]} sizes="(min-width: 1024px) 560px, 100vw" class="w-full rounded-3xl aspect-[4/3] object-cover" />
      </div>
      <div class="lg:col-span-6">
        <p class="eyebrow">Acolhimento</p>
        <h2 class="mt-3 text-4xl md:text-5xl text-anil-escuro">Uma casa preparada para receber todo mundo</h2>
        <ul class="mt-8 space-y-3 text-lg text-tinta-suave">
          {site.acolhimento.map((a) => (
            <li class="flex gap-3"><svg class="mt-2 shrink-0 text-anil" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7.5l3 3 7-7"/></svg>{a}</li>
          ))}
        </ul>
        <a href="/tour-virtual/" class="btn btn-anil mt-9">Ver a casa em 360°</a>
      </div>
    </div>
  </section>

  <Faq itens={faqGeral} />
  <Chamada local="primeira_visita_chamada" titulo="Pronto para a sua primeira gira?" />
</Base>
