---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Chamada from '../../components/Chamada.astro';
import capaPadrao from '../../assets/fotos/conga-noite-detalhe.jpg';
import { site, whatsappLink } from '../../config/site';
import { postsPublicados, dataBR, minutosLeitura } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await postsPublicados();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, todos: posts } }));
}) satisfies GetStaticPaths;

const { post, todos } = Astro.props;
const { titulo, descricao, data, atualizado, categoria, capa, capaAlt, autor } = post.data;
const { Content, headings } = await render(post);
const url = `${site.url}/blog/${post.id}/`;
const minutos = minutosLeitura(post.body);
const indice = headings.filter((h) => h.depth === 2);

const og = await getImage({ src: capa ?? capaPadrao, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Relacionados: mesma categoria primeiro, depois os mais recentes
const relacionados = todos
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.categoria === categoria) - Number(a.data.categoria === categoria))
  .slice(0, 3);

const autorEhCasa = autor === site.nome;
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: titulo,
    description: descricao,
    url,
    mainEntityOfPage: { '@id': `${url}#pagina` },
    datePublished: data.toISOString(),
    dateModified: (atualizado ?? data).toISOString(),
    inLanguage: 'pt-BR',
    articleSection: categoria,
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    image: new URL(og.src, site.url).href,
    author: autorEhCasa ? { '@id': `${site.url}/#templo` } : { '@type': 'Person', name: autor },
    publisher: { '@id': `${site.url}/#templo` },
    isPartOf: { '@id': `${site.url}/blog/#blog` },
  },
];
---
<Base
  title={titulo.length <= 49 ? `${titulo} | Choupana` : titulo}
  description={descricao}
  ogImage={og.src}
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }, { name: titulo, path: `/blog/${post.id}/` }]}
  schema={schema}
>
  <meta slot="head" property="article:published_time" content={data.toISOString()} />
  <meta slot="head" property="article:section" content={categoria} />

  <article>
    <header class="pt-10 md:pt-16">
      <div class="wrap">
        <nav aria-label="Trilha" class="text-sm text-tinta-suave">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-anil">Início</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-anil">Blog</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-tinta line-clamp-1">{titulo}</li>
          </ol>
        </nav>
        <div class="mt-10 max-w-4xl">
          <p class="eyebrow">{categoria}</p>
          <h1 class="mt-4 text-[2.4rem] sm:text-5xl md:text-6xl text-anil-escuro">{titulo}</h1>
          <p class="mt-6 text-lg md:text-xl text-tinta-suave max-w-3xl">{descricao}</p>
          <p class="mt-6 text-sm text-tinta-suave">
            Por <span class="font-semibold text-tinta">{autor}</span>{' · '}
            <time datetime={data.toISOString()}>{dataBR(data)}</time>
            {atualizado && <>{' · atualizado em '}<time datetime={atualizado.toISOString()}>{dataBR(atualizado)}</time></>}
            {` · ${minutos} min de leitura`}
          </p>
        </div>
        <Image
          src={capa ?? capaPadrao}
          alt={capaAlt ?? ''}
          widths={[640, 1024, 1600, 2000]}
          sizes="(min-width: 1216px) 1152px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="mt-12 w-full rounded-3xl aspect-[16/9] object-cover"
        />
      </div>
    </header>

    <div class="wrap py-14 md:py-20 grid gap-12 lg:grid-cols-12">
      {indice.length >= 3 && (
        <aside class="lg:col-span-3 order-2 lg:order-1">
          <nav aria-label="Neste texto" class="lg:sticky lg:top-28">
            <p class="eyebrow">Neste texto</p>
            <ol class="mt-4 space-y-2.5 text-[0.95rem] border-l border-linha">
              {indice.map((h) => <li><a href={`#${h.slug}`} class="block -ml-px border-l border-transparent pl-4 text-tinta-suave hover:text-anil hover:border-anil no-underline">{h.text}</a></li>)}
            </ol>
          </nav>
        </aside>
      )}
      <div class:list={['order-1 lg:order-2', indice.length >= 3 ? 'lg:col-span-8 lg:col-start-5' : 'lg:col-span-8 lg:col-start-3']}>
        <div class="prose-casa prose-post text-[1.125rem] text-tinta-suave">
          <Content />
        </div>

        <aside class="mt-16 rounded-3xl bg-noite text-white p-8 md:p-10 on-dark">
          <p class="eyebrow">Venha à gira</p>
          <p class="mt-3 font-display text-3xl">Quer conhecer a Choupana de perto?</p>
          <p class="mt-3 text-white/75">{site.giras.resumo}, com atendimento gratuito em {site.endereco.bairro}, {site.endereco.cidade}.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="blog_post" class="btn btn-ocre">Falar no WhatsApp</a>
            <a href="/primeira-visita/" class="btn btn-linha text-white">Guia da primeira visita</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="bg-cal-2 py-20 md:py-24" aria-labelledby="rel-titulo">
      <div class="wrap">
        <h2 id="rel-titulo" class="text-3xl md:text-4xl text-anil-escuro">Continue lendo</h2>
        <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {relacionados.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <Chamada local="blog_post_chamada" />
</Base>
