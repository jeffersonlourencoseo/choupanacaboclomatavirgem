---
import Base from '../layouts/Base.astro';
---
<Base noindex title="Página não encontrada | Choupana do Caboclo Mata Virgem" description="A página que você procurou não existe. Volte para o início do site da Choupana do Caboclo Mata Virgem, templo de Umbanda em Nova Iguaçu.">
  <section class="py-32">
    <div class="wrap text-center max-w-xl">
      <p class="eyebrow">Erro 404</p>
      <h1 class="mt-4 text-5xl md:text-6xl text-anil-escuro">Este caminho não leva a lugar nenhum</h1>
      <p class="mt-6 text-lg text-tinta-suave">A página que você procurou não existe ou mudou de endereço.</p>
      <a href="/" class="btn btn-anil mt-9">Voltar ao início</a>
    </div>
  </section>
</Base>
