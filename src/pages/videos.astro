---
import Base from '../layouts/Base.astro';
import VideoCards from '../components/VideoCards.astro';
import Chamada from '../components/Chamada.astro';
import { site } from '../config/site';
import { videos, duracaoISO } from '../data/videos';

const schema = videos.map((v) => ({
  '@type': 'VideoObject',
  '@id': `${site.url}/videos/#${v.id}`,
  name: v.titulo,
  description: v.descricao,
  thumbnailUrl: [`${site.url}/videos/${v.id}-capa.jpg`, `${site.url}/videos/${v.id}-capa-720.webp`],
  uploadDate: `${v.data}T12:00:00-03:00`,
  duration: duracaoISO(v.duracao),
  contentUrl: `${site.url}/videos/${v.id}.mp4`,
  embedUrl: `${site.url}/videos/`,
  inLanguage: 'pt-BR',
  transcript: v.narracao,
  publisher: { '@id': `${site.url}/#templo` },
  isFamilyFriendly: true,
}));
---
<Base
  title="Vídeos da Choupana do Caboclo Mata Virgem | Umbanda"
  description="Vídeos da Choupana do Caboclo Mata Virgem, templo de Umbanda em Nova Iguaçu: pontos cantados de Caboclo, Oxóssi e Exu, a casa e ensinamentos da Raiz de Guiné."
  breadcrumbs={[{ name: 'Vídeos', path: '/videos/' }]}
  schema={schema}
>
  <section class="pt-10 md:pt-16 pb-12">
    <div class="wrap">
      <nav aria-label="Trilha" class="text-sm text-tinta-suave">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-anil">Início</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tinta">Vídeos</li>
        </ol>
      </nav>
      <div class="mt-10 grid gap-6 lg:grid-cols-12 items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow">Vídeos</p>
          <h1 class="mt-4 text-[2.6rem] sm:text-5xl md:text-6xl lg:text-[4.4rem] text-anil-escuro">Vídeos da Choupana</h1>
        </div>
        <p class="lg:col-span-5 text-lg md:text-xl text-tinta-suave">Pontos cantados, a casa e os ensinamentos da Umbanda Esotérica em vídeos curtos. Toque num vídeo para assistir.</p>
      </div>
      <span class="risco mt-12" aria-hidden="true"></span>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="wrap">
      <VideoCards local="pagina_videos" />
      <p class="mt-14 text-tinta-suave">Mais vídeos no Instagram <a href={site.redes.instagram} target="_blank" rel="noopener" class="text-anil font-semibold underline">{site.redes.instagramUser}</a>.</p>
    </div>
  </section>

  <Chamada local="videos_chamada" titulo="Agora venha viver uma gira" />
</Base>
