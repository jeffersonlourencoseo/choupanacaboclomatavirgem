---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Mapa from '../components/Mapa.astro';
import { site, whatsappLink } from '../config/site';
import fachada from '../assets/fotos/entrada-dia.jpg';
---
<Base
  title="Como chegar | Choupana do Caboclo Mata Virgem, Lagoinha"
  description="Endereço, mapa e WhatsApp da Choupana do Caboclo Mata Virgem: R. Mercúrio, 70, Lagoinha, Nova Iguaçu (RJ). Estacionamento gratuito e entrada acessível."
  breadcrumbs={[{ name: 'Como chegar', path: '/contato/' }]}
>
  <PageHero
    crumb="Como chegar"
    eyebrow="Endereço e contato"
    titulo="Como chegar à Choupana"
    lead={`Estamos na ${site.endereco.rua}, em ${site.endereco.bairro}, Nova Iguaçu. Há estacionamento gratuito no local e na rua.`}
  />

  <section class="pb-20 md:pb-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5 space-y-10">
        <div>
          <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-ocre-texto">Endereço</h2>
          <address class="not-italic mt-3 font-display text-2xl md:text-3xl leading-snug">
            {site.endereco.rua}<br />
            {site.endereco.bairro}, {site.endereco.cidade} – {site.endereco.uf}<br />
            CEP {site.endereco.cep}
          </address>
        </div>
        <div>
          <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-ocre-texto">WhatsApp e telefone</h2>
          <p class="mt-3 font-display text-2xl md:text-3xl"><a href={`tel:${site.telefoneE164}`} data-evento="clique_telefone" data-local="contato" class="hover:text-anil">{site.telefone}</a></p>
          <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="contato" class="btn btn-ocre mt-5">Mandar mensagem no WhatsApp</a>
        </div>
        <div>
          <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-ocre-texto">Giras abertas</h2>
          <p class="mt-3 text-lg">{site.giras.resumo}. Atendimento gratuito.</p>
        </div>
        <div>
          <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-ocre-texto">Redes sociais</h2>
          <ul class="mt-3 space-y-2 text-lg">
            <li><a href={site.redes.instagram} target="_blank" rel="noopener" class="text-anil underline">Instagram {site.redes.instagramUser}</a></li>
            <li><a href={site.redes.facebook} target="_blank" rel="noopener" class="text-anil underline">Facebook da Choupana</a></li>
          </ul>
        </div>
      </div>
      <div class="lg:col-span-7">
        <Mapa local="contato_mapa" />
        <p class="mt-5 text-tinta-suave">Já veio à casa? <a href={site.avaliarUrl} target="_blank" rel="noopener" class="text-anil underline">Deixe sua avaliação no Google</a>. Ela ajuda outras pessoas a encontrar a Choupana.</p>
      </div>
    </div>
  </section>
</Base>
