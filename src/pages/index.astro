---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tour360 from '../components/Tour360.astro';
import Faq from '../components/Faq.astro';
import Chamada from '../components/Chamada.astro';
import Mapa from '../components/Mapa.astro';
import { site, whatsappLink } from '../config/site';
import { faqGeral } from '../data/faq';
import { depoimentos } from '../data/depoimentos';
import PostCard from '../components/PostCard.astro';
import ProximaGira from '../components/ProximaGira.astro';
import VideoCards from '../components/VideoCards.astro';
import { postsPublicados } from '../lib/blog';

const ultimosPosts = (await postsPublicados()).slice(0, 3);

import hero from '../assets/fotos/hero-conga.jpg';
import fachada from '../assets/fotos/fachada-frente.jpg';
import congaDetalhe from '../assets/fotos/conga-noite-detalhe.jpg';
import salaoDia from '../assets/fotos/foto-4.jpg';

const linhas = [
  { n: 'I', nome: 'Caboclos', texto: 'Espíritos ligados às matas, de força, firmeza e cura. É a linha do Caboclo Mata Virgem, que rege a casa e dá nome à Choupana.' },
  { n: 'II', nome: 'Pretos Velhos', texto: 'A sabedoria de quem viveu muito. Com paciência e humildade, aconselham, benzem e ajudam a carregar os pesos da vida.' },
  { n: 'III', nome: 'Crianças', texto: 'A alegria e a pureza de Yori. Trazem leveza, renovam a esperança e lembram que a fé também é doçura.' },
  { n: 'IV', nome: 'Exu', texto: 'Guardiões dos caminhos e da casa. Trabalham na proteção, na ordem e na abertura de caminhos, sempre a serviço da caridade.' },
];

const visita = [
  { t: 'Venha de roupa clara', d: 'De preferência branca, confortável e discreta.' },
  { t: 'Chegue um pouco antes', d: 'A gira começa às 18h. Chegando cedo, você se acomoda com calma.' },
  { t: 'Não precisa pagar nada', d: 'O atendimento é gratuito. Quem quiser pode doar material usado nos trabalhos.' },
  { t: 'Respeite a liturgia', d: 'Silêncio durante os trabalhos e atenção às orientações dos médiuns da casa.' },
];
---
<Base
  title="Choupana do Caboclo Mata Virgem | Umbanda em Nova Iguaçu"
  description="Templo de Umbanda de Raiz de Guiné em Lagoinha, Nova Iguaçu (RJ). Giras abertas de 14 em 14 dias, às 18h, com atendimento gratuito de Caboclos e Pretos Velhos."
  faq={faqGeral}
  headerOverHero
>
  <!-- HERO -->
  <section class="on-dark relative isolate min-h-[100svh] flex flex-col bg-noite text-white overflow-hidden">
    <Image
      src={hero}
      alt="Congá da Choupana do Caboclo Mata Virgem iluminado por velas, com o terreiro de areia em primeiro plano"
      widths={[640, 960, 1280, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover object-[72%_50%] md:object-center"
    />
    <div class="absolute inset-0 -z-10 bg-black/20"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(14_16_48/.92)_0%,rgb(14_16_48/.7)_38%,rgb(14_16_48/.1)_70%,transparent_100%)] max-md:bg-[linear-gradient(180deg,rgb(14_16_48/.55)_0%,rgb(14_16_48/.35)_35%,rgb(14_16_48/.85)_70%,rgb(14_16_48/.97)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 -z-10 bg-gradient-to-t from-noite to-transparent"></div>

    <div class="wrap flex-1 flex flex-col justify-end pt-32 pb-10 md:pb-14">
      <p class="eyebrow">{site.vertente}</p>
      <h1 class="mt-4 max-w-4xl">
        <span class="block text-[2.7rem] leading-[1.02] sm:text-6xl md:text-7xl lg:text-[5.4rem]">Choupana do Caboclo Mata Virgem</span>
        <span class="mt-4 block font-sans text-lg md:text-2xl font-normal tracking-normal text-white/85">Templo de Umbanda em Nova Iguaçu</span>
      </h1>
      <p class="mt-6 max-w-xl text-white/80 md:text-lg">Uma casa de caridade de portas abertas. Venha tomar um passe, conversar com os guias e sair em paz.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="hero" class="btn btn-ocre">Confirmar a próxima gira</a>
        <a href="/tour-virtual/" class="btn btn-linha text-white">Conhecer a casa em 360°</a>
      </div>

      <dl class="mt-12 md:mt-16 grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-5 border-t border-white/15 pt-6 text-sm md:text-[0.95rem]">
        <div><dt class="text-white/55">Próxima gira</dt><dd class="mt-1 font-semibold first-letter:uppercase"><a href="/giras/#calendario" class="hover:text-ocre no-underline"><ProximaGira formato="curto" /></a></dd></div>
        <div><dt class="text-white/55">Atendimento</dt><dd class="mt-1 font-semibold">Gratuito</dd></div>
        <div><dt class="text-white/55">Onde</dt><dd class="mt-1 font-semibold">Lagoinha, Nova Iguaçu</dd></div>
        <div><dt class="text-white/55">No Google</dt><dd class="mt-1 font-semibold"><span class="text-ocre" aria-hidden="true">★</span> {site.google.nota} · {site.google.avaliacoes} avaliações</dd></div>
      </dl>
    </div>
  </section>

  <!-- A CASA -->
  <section class="py-20 md:py-32" aria-labelledby="casa-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16 items-center">
      <div class="lg:col-span-6 order-2">
        <figure class="relative">
          <Image src={fachada} alt="Fachada da Choupana com o ponto riscado pintado na parede, as letras T.U.O e o nome Choupana do Caboclo Mata Virgem" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 560px, 100vw" class="w-full rounded-3xl aspect-[4/5] object-cover object-[55%_50%]" />
          <figcaption class="mt-3 text-sm text-tinta-suave">A fachada da casa, com o ponto riscado pintado na parede.</figcaption>
        </figure>
      </div>
      <div class="lg:col-span-6 order-1">
        <p class="eyebrow">A casa</p>
        <h2 id="casa-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">Uma choupana na mata, aberta a quem chega</h2>
        <span class="risco mt-8 max-w-md" aria-hidden="true"></span>
        <div class="mt-8 space-y-5 text-lg text-tinta-suave max-w-xl">
          <p>A Choupana do Caboclo Mata Virgem é um templo de {site.vertente} em Lagoinha, Nova Iguaçu. A casa é regida pelo {site.regente} e conduzida pelo <strong class="text-tinta font-semibold">{site.mestre.nome}</strong>, que cuida de cada filho e de cada visitante com amor e respeito.</p>
          <p>Aqui a Umbanda é vivida como caridade: ninguém paga para ser atendido. A Choupana é filiada ao {site.filiacao.nome} e trabalha com Caboclos, Pretos Velhos, Crianças e Exu nas giras abertas ao público.</p>
        </div>
        <a href="/a-casa/" class="mt-9 inline-flex items-center gap-2 font-semibold text-anil hover:text-anil-escuro">
          Conheça a história da casa
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- LINHAS -->
  <section class="bg-areia/45 py-20 md:py-32" aria-labelledby="linhas-titulo">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-12 items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow">Linhas de trabalho</p>
          <h2 id="linhas-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">Quem trabalha nas giras da Choupana</h2>
        </div>
        <p class="lg:col-span-5 text-lg text-tinta-suave">Em cada gira, uma ou mais linhas descem para atender. Todas trabalham pelo mesmo propósito: caridade, orientação e fortalecimento espiritual.</p>
      </div>

      <ol class="mt-14 grid md:grid-cols-2 border-t border-areia-escura/50">
        {linhas.map((l, i) => (
          <li class:list={['py-9 md:py-11 border-b border-areia-escura/50 grid grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr] gap-4', i % 2 === 0 ? 'md:pr-12 md:border-r' : 'md:pl-12']}>
            <span class="font-display text-2xl md:text-3xl text-ocre-texto leading-none pt-1" aria-hidden="true">{l.n}</span>
            <div>
              <h3 class="text-3xl md:text-4xl">{l.nome}</h3>
              <p class="mt-3 text-tinta-suave max-w-md">{l.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PRIMEIRA VISITA -->
  <section class="py-20 md:py-32" aria-labelledby="visita-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Primeira vez?</p>
        <h2 id="visita-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">O que saber antes de vir à gira</h2>
        <p class="mt-6 text-lg text-tinta-suave">Não é preciso ser da Umbanda nem saber nada antes. Chegue com respeito e de coração aberto. A casa orienta você em cada passo.</p>
        <Image src={salaoDia} alt="Salão da assistência da Choupana, com cadeiras e espadas-de-são-jorge, visto do terreiro" widths={[480, 800]} sizes="(min-width: 1024px) 440px, 100vw" class="mt-10 w-full rounded-3xl aspect-[4/3] object-cover" />
      </div>
      <div class="lg:col-span-7 lg:pt-4">
        <ul class="grid sm:grid-cols-2 gap-px bg-linha rounded-3xl overflow-hidden ring-1 ring-linha">
          {visita.map((v, i) => (
            <li class="bg-cal p-7 md:p-9">
              <span class="font-display text-sm text-ocre-texto">0{i + 1}</span>
              <h3 class="mt-3 text-2xl">{v.t}</h3>
              <p class="mt-2 text-tinta-suave">{v.d}</p>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/primeira-visita/" class="btn btn-anil">Guia da primeira visita</a>
          <a href="/giras/" class="btn btn-linha text-anil-escuro">Como funcionam as giras</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TOUR -->
  <section class="bg-cal-2 py-20 md:py-28" aria-labelledby="tour-titulo">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 items-end mb-10">
        <div class="lg:col-span-7">
          <p class="eyebrow">Tour virtual</p>
          <h2 id="tour-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">Entre na Choupana sem sair de casa</h2>
        </div>
        <p class="lg:col-span-5 text-lg text-tinta-suave">Fotos em 360° da rua, do quintal, da assistência e do congá, de dia e em noite de gira. Arraste a imagem para olhar ao redor, ou veja a <a href="/galeria/" class="text-anil font-semibold underline">galeria de fotos</a>.</p>
      </div>
      <Tour360 />
    </div>
  </section>

  <!-- VÍDEOS -->
  <section class="py-20 md:py-28" aria-labelledby="videos-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow">Vídeos</p>
        <h2 id="videos-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">A Choupana em vídeo</h2>
        <p class="mt-6 text-lg text-tinta-suave">Conheça a casa em menos de 30 segundos e aprenda, com os ensinamentos de Mestre Yapacany, por que o ponto cantado não é música.</p>
        <a href="/videos/" class="mt-8 inline-flex items-center gap-2 font-semibold text-anil hover:text-anil-escuro">
          Ver todos os vídeos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="lg:col-span-7">
        <VideoCards local="home_videos" colunas="md:grid-cols-2" mostrarNarracao={false} />
      </div>
    </div>
  </section>

  <!-- DEPOIMENTOS -->
  <section class="py-20 md:py-32" aria-labelledby="dep-titulo">
    <div class="wrap">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Quem passou pela casa</p>
          <h2 id="dep-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro max-w-2xl">“Sinto paz, tranquilidade e harmonia”</h2>
        </div>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-full ring-1 ring-linha px-5 py-3 hover:bg-cal-2 no-underline shrink-0">
          <span class="text-ocre text-lg tracking-wider" aria-hidden="true">★★★★★</span>
          <span class="font-semibold">{site.google.nota} no Google</span>
          <span class="text-tinta-suave text-sm">({site.google.avaliacoes} avaliações)</span>
        </a>
      </div>
      <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {depoimentos.map((d) => (
          <li class="flex flex-col rounded-3xl bg-cal-2 p-7">
            <svg width="28" height="22" viewBox="0 0 28 22" fill="currentColor" class="text-ocre" aria-hidden="true"><path d="M0 22V12.6C0 5.4 4 1.1 11 0l1.3 3.2C8.4 4.3 6.4 6.7 6.2 10H11v12H0Zm16 0V12.6C16 5.4 20 1.1 27 0l1 3.2c-3.9 1.1-5.9 3.5-6.1 6.8H27v12H16Z"/></svg>
            <blockquote class="mt-5 flex-1 text-[1.05rem] leading-relaxed">{d.texto}</blockquote>
            <p class="mt-6 text-sm font-semibold text-tinta-suave">{d.autor} · Avaliação no Google</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COMO CHEGAR -->
  <section class="bg-areia/45 py-20 md:py-28" aria-labelledby="chegar-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow">Como chegar</p>
        <h2 id="chegar-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">Em Lagoinha, Nova Iguaçu</h2>
        <address class="not-italic mt-7 text-lg">
          {site.endereco.rua}<br />
          {site.endereco.bairro}, {site.endereco.cidade} – {site.endereco.uf}<br />
          CEP {site.endereco.cep}
        </address>
        <p class="mt-4"><a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="home_como_chegar" class="text-lg font-semibold text-anil">{site.telefone}</a></p>
        <h3 class="mt-10 font-sans text-sm font-semibold uppercase tracking-[0.14em] text-ocre-texto">Uma casa para todos</h3>
        <ul class="mt-4 space-y-2.5 text-tinta-suave">
          {site.acolhimento.map((a) => (
            <li class="flex gap-3"><svg class="mt-1.5 shrink-0 text-anil" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7.5l3 3 7-7"/></svg>{a}</li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-7">
        <Mapa local="home_mapa" />
      </div>
    </div>
  </section>

  <Faq itens={faqGeral} />

  {ultimosPosts.length > 0 && (
    <section class="pb-20 md:pb-28" aria-labelledby="blog-titulo">
      <div class="wrap">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-t border-linha pt-16 md:pt-20">
          <div>
            <p class="eyebrow">Blog da Choupana</p>
            <h2 id="blog-titulo" class="mt-3 text-4xl md:text-[3.4rem] text-anil-escuro">Palavras da mata</h2>
          </div>
          <a href="/blog/" class="inline-flex items-center gap-2 font-semibold text-anil hover:text-anil-escuro shrink-0">
            Ver todos os textos
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {ultimosPosts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="pb-20 md:pb-28">
    <div class="wrap">
      <figure class="grid md:grid-cols-12 gap-6 items-center">
        <Image src={congaDetalhe} alt="Detalhe do congá com o arco amarelo, os pontos riscados e as velas acesas" widths={[640, 1024, 1600]} sizes="(min-width: 768px) 66vw, 100vw" class="md:col-span-8 w-full rounded-3xl aspect-[16/10] object-cover" />
        <figcaption class="md:col-span-4 font-display text-2xl md:text-3xl leading-snug text-anil-escuro">
          “Caboclo vem da mata virgem e tem sua choupana na Jurema.”
          <span class="mt-4 block font-sans text-sm text-tinta-suave">Ponto de Caboclo cantado nos terreiros de Umbanda.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <Chamada local="home_chamada_final" />
</Base>
