---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, nav, whatsappLink, enderecoLinha } from '../config/site';
const ano = new Date().getFullYear();
---
<footer class="on-dark bg-noite text-white/85">
  <div class="wrap pt-16 pb-10">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-4">
          <span class="grid place-items-center size-16 rounded-full bg-white shrink-0">
            <Image src={logo} alt={`Logo da ${site.nome}`} width={128} height={128} class="size-14" />
          </span>
          <p class="font-display text-2xl text-white leading-tight">{site.nome}</p>
        </div>
        <p class="mt-5 max-w-md text-white/70">
          {site.tipo} de {site.vertente.replace('Umbanda de ', '')} em {site.endereco.cidade}. Casa de caridade com giras abertas e atendimento gratuito.
        </p>
        <div class="mt-6 flex gap-3">
          <a href={site.redes.instagram} target="_blank" rel="noopener" class="grid place-items-center size-11 rounded-full ring-1 ring-white/20 hover:bg-white/10" aria-label="Instagram da Choupana">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href={site.redes.facebook} target="_blank" rel="noopener" class="grid place-items-center size-11 rounded-full ring-1 ring-white/20 hover:bg-white/10" aria-label="Facebook da Choupana">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.87.25-1.46 1.5-1.46h1.5V4.48A20 20 0 0 0 14.3 4.4c-2.16 0-3.64 1.32-3.64 3.74v2.36H8.2v3h2.46V21h2.84Z"/></svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow">Navegação</p>
        <ul class="mt-4 space-y-2.5">
          {nav.map((i) => <li><a href={i.href} class="hover:text-white no-underline">{i.label}</a></li>)}
          <li><a href="/privacidade/" class="hover:text-white no-underline">Privacidade</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="eyebrow">Endereço e contato</p>
        <address class="not-italic mt-4 space-y-3">
          <p>{site.endereco.rua}<br />{site.endereco.bairro}, {site.endereco.cidade} – {site.endereco.uf}<br />CEP {site.endereco.cep}</p>
          <p><a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="rodape_numero" class="hover:text-white">{site.telefone}</a></p>
          <p class="text-white/70">{site.giras.resumo}.</p>
        </address>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="rodape" class="btn btn-ocre !min-h-11 !py-2">WhatsApp</a>
          <a href={site.rotaUrl} target="_blank" rel="noopener" data-evento="clique_rota" data-local="rodape" class="btn btn-linha !min-h-11 !py-2 text-white">Como chegar</a>
        </div>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-white/10 flex flex-col sm:flex-row gap-3 justify-between text-sm text-white/55">
      <p>© {ano} {site.nome}. Saravá!</p>
      <p>{enderecoLinha}</p>
    </div>
  </div>
</footer>
