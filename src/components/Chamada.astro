---
import { Image } from 'astro:assets';
import foto from '../assets/fotos/entrada-noite.jpg';
import { site, whatsappLink } from '../config/site';

interface Props { titulo?: string; texto?: string; local: string }
const {
  titulo = 'A porta está aberta para você',
  texto = `${site.giras.resumo}. O atendimento é gratuito. Chame no WhatsApp para confirmar a data da próxima gira.`,
  local,
} = Astro.props;
---
<section class="on-dark relative isolate overflow-hidden bg-noite text-white">
  <Image src={foto} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-35" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-noite via-noite/85 to-noite/40"></div>
  <div class="wrap py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Giras abertas</p>
      <h2 class="mt-3 text-4xl md:text-6xl">{titulo}</h2>
      <p class="mt-6 text-lg text-white/80">{texto}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local={local} class="btn btn-ocre">Confirmar a próxima gira</a>
        <a href={site.rotaUrl} target="_blank" rel="noopener" data-evento="clique_rota" data-local={local} class="btn btn-linha text-white">Traçar rota no mapa</a>
      </div>
    </div>
  </div>
</section>
