---
import { videos as todos, duracaoTexto, type Video } from '../data/videos';

interface Props { videos?: Video[]; local: string; mostrarNarracao?: boolean; colunas?: string }
const { videos = todos, local, mostrarNarracao = true, colunas = 'md:grid-cols-3 lg:grid-cols-4' } = Astro.props;
---
<ul class:list={['grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-5', colunas]} data-videos data-local={local}>
  {videos.map((v) => (
    <li class="flex flex-col">
      <button
        type="button"
        class="group relative block aspect-[9/16] w-full overflow-hidden rounded-2xl md:rounded-3xl bg-noite text-left shadow-[0_20px_40px_-24px_rgb(14_16_48/.6)]"
        data-video={v.id}
        data-titulo={v.titulo}
        aria-label={`Assistir ao vídeo: ${v.titulo} (${duracaoTexto(v.duracao)})`}
      >
        <picture>
          <source type="image/webp" srcset={`/videos/${v.id}-capa-360.webp 360w, /videos/${v.id}-capa-720.webp 720w`} sizes="(min-width: 1024px) 280px, (min-width: 768px) 30vw, 50vw" />
          <img src={`/videos/${v.id}-capa.jpg`} alt="" width="720" height="1280" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
        </picture>
        <span class="absolute inset-0 bg-gradient-to-t from-noite/70 via-transparent to-transparent" aria-hidden="true"></span>
        <span class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-2" aria-hidden="true">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-ocre py-1.5 pl-2 pr-3 text-xs md:text-sm font-semibold text-noite shadow-lg transition-transform group-hover:scale-105">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
            Assistir
          </span>
          <span class="rounded-md bg-noite/80 px-2 py-0.5 text-xs font-semibold text-white">{duracaoTexto(v.duracao)}</span>
        </span>
      </button>
      <h3 class="mt-4 font-display text-xl md:text-2xl leading-snug text-anil-escuro">{v.titulo}</h3>
      <p class="mt-2 text-sm md:text-[0.95rem] text-tinta-suave">{v.descricao}</p>
      {mostrarNarracao && (
        <details class="group mt-3">
          <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-anil [&::-webkit-details-marker]:hidden">
            Ler a narração
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="transition-transform group-open:rotate-180" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p class="mt-2 text-sm leading-relaxed text-tinta-suave">{v.narracao}</p>
        </details>
      )}
    </li>
  ))}
</ul>

<dialog class="player" data-player aria-label="Vídeo">
  <div class="flex h-full w-full flex-col items-center justify-center gap-3 p-3 md:p-6" data-player-fundo>
    <div class="flex w-full max-w-[min(100%,calc((100dvh-7rem)*9/16))] items-center justify-between gap-3 text-white">
      <p class="font-display text-lg md:text-xl leading-tight line-clamp-2" data-player-titulo></p>
      <button type="button" class="grid size-11 shrink-0 place-items-center rounded-full bg-white/10 hover:bg-white/20" data-player-fechar aria-label="Fechar vídeo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <video
      class="aspect-[9/16] w-full max-w-[min(100%,calc((100dvh-7rem)*9/16))] rounded-2xl bg-black"
      controls playsinline preload="none" data-player-video
    ></video>
  </div>
</dialog>

<style>
  .player { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(10 11 34 / .96); }
  .player::backdrop { background: rgb(10 11 34 / .92); }
  video::cue { font-family: var(--font-sans); font-size: 1rem; background: rgb(14 16 48 / .8); }
</style>

<script>
  const player = document.querySelector<HTMLDialogElement>('[data-player]');
  if (player && !player.dataset.pronto) {
    player.dataset.pronto = '1';
    const video = player.querySelector<HTMLVideoElement>('[data-player-video]')!;
    const titulo = player.querySelector<HTMLElement>('[data-player-titulo]')!;
    let origem: HTMLElement | null = null;

    const abrir = (btn: HTMLButtonElement) => {
      const id = btn.dataset.video!;
      origem = btn;
      titulo.textContent = btn.dataset.titulo || '';
      video.poster = `/videos/${id}-capa-720.webp`;
      video.innerHTML = `<source src="/videos/${id}.mp4" type="video/mp4"><track kind="captions" srclang="pt-BR" label="Português" src="/videos/${id}.vtt">`;
      video.load();
      player.showModal();
      document.documentElement.style.overflow = 'hidden';
      video.play().catch(() => {});
      const local = btn.closest<HTMLElement>('[data-videos]')?.dataset.local || 'videos';
      if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'video_play', { video_id: id, local_botao: local });
    };

    document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((b) => b.addEventListener('click', () => abrir(b)));
    player.querySelector('[data-player-fechar]')!.addEventListener('click', () => player.close());
    player.addEventListener('click', (e) => { if (e.target === player || (e.target as HTMLElement).hasAttribute('data-player-fundo')) player.close(); });
    player.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.innerHTML = '';
      video.load();
      document.documentElement.style.overflow = '';
      origem?.focus();
    });
  }
</script>
