---
import ProximaGira from './ProximaGira.astro';
import { datasGiras, porMes, diaSemana, hojeISO } from '../data/giras';
import { site, whatsappLink } from '../config/site';

const hoje = hojeISO();
const meses = porMes(datasGiras);
const proxima = datasGiras.find((d) => d >= hoje);
---
<section id="calendario" class="py-20 md:py-28 scroll-mt-24" aria-labelledby="cal-titulo">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12 items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow">Calendário</p>
        <h2 id="cal-titulo" class="mt-3 text-4xl md:text-5xl text-anil-escuro">Datas das giras abertas</h2>
        <p class="mt-5 text-lg text-tinta-suave max-w-xl">Todas as giras começam às 18h e o atendimento é gratuito. Em 2027, as giras são aos sábados, de 14 em 14 dias.</p>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-3xl bg-noite text-white p-7 on-dark">
          <p class="eyebrow">Próxima gira</p>
          <p class="mt-2 font-display text-3xl first-letter:uppercase"><ProximaGira /></p>
          <a href={whatsappLink('Olá! Quero confirmar minha presença na próxima gira aberta da Choupana.')} target="_blank" rel="noopener" data-evento="clique_whatsapp" data-local="calendario_proxima" class="btn btn-ocre mt-5 !min-h-11 !py-2">Avisar que vou</a>
        </div>
      </div>
    </div>

    <div class="mt-12 md:mt-14 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-8 md:gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      {meses.map((m) => (
        <div>
          <h3 class="font-sans text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-ocre-texto border-b border-linha pb-2.5">{m.titulo}</h3>
          <ul class="mt-2 space-y-1">
            {m.dias.map((d) => (
              <li
                class="gira flex items-baseline justify-between gap-2 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2"
                data-gira-data={d}
                data-passada={d < hoje ? '' : undefined}
                data-proxima={d === proxima ? '' : undefined}
              >
                <time datetime={`${d}T18:00-03:00`} class="font-display text-lg sm:text-xl">{d.slice(8, 10)}/{d.slice(5, 7)}</time>
                <span class="text-xs sm:text-sm text-tinta-suave capitalize">{diaSemana(d).slice(0, 3)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-10 text-sm text-tinta-suave">Em feriados e datas festivas a casa pode mudar o calendário. Na dúvida, confirme pelo WhatsApp {site.telefone}.</p>
  </div>
</section>

<style>
  .gira[data-proxima] { background: var(--color-anil); color: #fff; }
  .gira[data-proxima] span { color: rgb(255 255 255 / .8); }
  .gira[data-passada] { opacity: .4; text-decoration: line-through; text-decoration-thickness: 1px; }
</style>
