---
import { Image } from 'astro:assets';
import capaPadrao from '../assets/fotos/conga-noite-detalhe.jpg';
import { dataBR, type Post } from '../lib/blog';

interface Props { post: Post; destaque?: boolean; eager?: boolean }
const { post, destaque = false, eager = false } = Astro.props;
const { titulo, descricao, data, categoria, capa, capaAlt } = post.data;
const href = `/blog/${post.id}/`;
---
<article class:list={['group relative flex flex-col', destaque && 'md:grid md:grid-cols-12 md:gap-10 md:items-center']}>
  <div class:list={['overflow-hidden rounded-3xl bg-cal-2', destaque && 'md:col-span-7']}>
    <Image
      src={capa ?? capaPadrao}
      alt={capaAlt ?? ''}
      widths={destaque ? [640, 960, 1400] : [480, 720]}
      sizes={destaque ? '(min-width: 768px) 680px, 100vw' : '(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw'}
      loading={eager ? 'eager' : 'lazy'}
      class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class:list={['mt-5', destaque && 'md:col-span-5 md:mt-0']}>
    <p class="eyebrow">{categoria}</p>
    <h3 class:list={['mt-2 text-anil-escuro', destaque ? 'text-3xl md:text-[2.6rem]' : 'text-2xl']}>
      <a href={href} class="no-underline after:absolute after:inset-0">{titulo}</a>
    </h3>
    <p class="mt-3 text-tinta-suave line-clamp-3">{descricao}</p>
    <p class="mt-4 text-sm text-tinta-suave"><time datetime={data.toISOString()}>{dataBR(data)}</time></p>
  </div>
</article>
