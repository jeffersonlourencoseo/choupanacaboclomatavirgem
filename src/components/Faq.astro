---
interface Props { itens: { q: string; a: string }[]; titulo?: string; id?: string }
const { itens, titulo = 'Perguntas frequentes', id = 'perguntas' } = Astro.props;
---
<section id={id} class="py-20 md:py-28" aria-labelledby={`${id}-titulo`}>
  <div class="wrap grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">Dúvidas</p>
      <h2 id={`${id}-titulo`} class="mt-3 text-4xl md:text-5xl text-anil-escuro">{titulo}</h2>
      <p class="mt-5 text-tinta-suave max-w-sm">Não achou sua resposta? Mande uma mensagem pelo WhatsApp. A casa responde com calma e carinho.</p>
    </div>
    <div class="lg:col-span-8">
      <ul class="border-t border-linha">
        {itens.map((f) => (
          <li class="border-b border-linha">
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-xl md:text-[1.4rem] leading-snug">{f.q}</h3>
                <span class="mt-1 grid place-items-center size-8 shrink-0 rounded-full ring-1 ring-linha group-open:bg-anil group-open:text-white group-open:ring-anil transition" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M7 2v10M2 7h10" class="group-open:hidden"/><path d="M2 7h10" class="hidden group-open:block"/></svg>
                </span>
              </summary>
              <p class="pb-6 pr-12 text-tinta-suave max-w-2xl">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
