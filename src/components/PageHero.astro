---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  titulo: string;
  lead: string;
  crumb: string;
  imagem?: ImageMetadata;
  alt?: string;
}
const { eyebrow, titulo, lead, crumb, imagem, alt = '' } = Astro.props;
---
<section class="pt-10 md:pt-16 pb-14 md:pb-20">
  <div class="wrap">
    <nav aria-label="Trilha" class="text-sm text-tinta-suave">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-anil">Início</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-tinta">{crumb}</li>
      </ol>
    </nav>
    <div class="mt-10 grid gap-10 lg:grid-cols-12 items-end">
      <div class:list={[imagem ? 'lg:col-span-7' : 'lg:col-span-9']}>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-4 text-[2.6rem] sm:text-5xl md:text-6xl lg:text-[4.4rem] text-anil-escuro">{titulo}</h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-tinta-suave">{lead}</p>
      </div>
      {imagem && (
        <div class="lg:col-span-5">
          <Image src={imagem} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 460px, 100vw" loading="eager" fetchpriority="high" class="w-full rounded-3xl aspect-[4/3] object-cover" />
        </div>
      )}
    </div>
    <span class="risco mt-14" aria-hidden="true"></span>
  </div>
</section>
